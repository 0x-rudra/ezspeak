#!/bin/bash
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
export PATH="$BIN_DIR:$PATH"
export ELECTRON_RUN_AS_NODE=""
unset ELECTRON_RUN_AS_NODE

CMD="$1"
if [ "$CMD" = "run" ]; then
  shift
  CMD="$1"
fi

if [ "$CMD" = "start" ]; then
  shift
  exec "$BIN_DIR/electron" . "$@"
elif [ "$CMD" = "dev" ]; then
  shift
  exec "$BIN_DIR/electron" . --dev "$@"
elif [ "$CMD" = "test" ]; then
  shift
  exec "$BIN_DIR/node" "$BIN_DIR/../tests/run_tests.js" "$@"
elif [ "$CMD" = "build" ]; then
  shift
  exec "$BIN_DIR/node" "$BIN_DIR/../node_modules/electron-builder/cli.js" "$@"
elif [ "$CMD" = "build:linux" ]; then
  shift
  exec "$BIN_DIR/node" "$BIN_DIR/../node_modules/electron-builder/cli.js" --linux "$@"
elif [ "$CMD" = "build:win" ]; then
  shift
  exec "$BIN_DIR/node" "$BIN_DIR/../node_modules/electron-builder/cli.js" --win "$@"
elif [ "$CMD" = "build:mac" ]; then
  shift
  exec "$BIN_DIR/node" "$BIN_DIR/../node_modules/electron-builder/cli.js" --mac "$@"
elif [ "$CMD" = "build:all" ]; then
  shift
  exec "$BIN_DIR/node" "$BIN_DIR/../node_modules/electron-builder/cli.js" -wml "$@"
elif [ "$CMD" = "pack" ]; then
  shift
  exec "$BIN_DIR/node" "$BIN_DIR/../node_modules/electron-builder/cli.js" --dir "$@"
elif [ "$CMD" = "pack:linux" ]; then
  shift
  exec "$BIN_DIR/node" "$BIN_DIR/../node_modules/electron-builder/cli.js" --linux --dir "$@"
elif [ "$CMD" = "pack:win" ]; then
  shift
  exec "$BIN_DIR/node" "$BIN_DIR/../node_modules/electron-builder/cli.js" --win --dir "$@"
elif [ "$CMD" = "pack:mac" ]; then
  shift
  exec "$BIN_DIR/node" "$BIN_DIR/../node_modules/electron-builder/cli.js" --mac --dir "$@"
else
  exec "$BIN_DIR/node" "$@"
fi

