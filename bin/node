#!/bin/bash
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
ELECTRON_BIN="$BIN_DIR/../node_modules/electron/dist/electron"
if [ ! -f "$ELECTRON_BIN" ]; then
  ELECTRON_BIN=$(find "$BIN_DIR/../node_modules" -name electron -type f -perm /111 2>/dev/null | grep -v "\.bin" | head -n 1)
fi
export ELECTRON_RUN_AS_NODE=1
export NODE_OPTIONS="--require $BIN_DIR/node-env.js ${NODE_OPTIONS:-}"
exec -a node "$ELECTRON_BIN" "$@"

