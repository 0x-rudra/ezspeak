{
  "name": "ezspeak",
  "productName": "EzSpeak",
  "desktopName": "ezspeak.desktop",
  "version": "0.2.0",
  "description": "Cross-platform voice dictation and transcription desktop app",
  "main": "main.js",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -wml",
    "pack": "electron-builder --dir",
    "pack:win": "electron-builder --win --dir",
    "pack:mac": "electron-builder --mac --dir",
    "pack:linux": "electron-builder --linux --dir",
    "test": "node tests/run_tests.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x-rudra/ezspeak.git"
  },
  "bugs": {
    "url": "https://github.com/0x-rudra/ezspeak/issues"
  },
  "homepage": "https://github.com/0x-rudra/ezspeak#readme",
  "keywords": [
    "voice",
    "transcription",
    "whisper",
    "dictation",
    "speech-to-text"
  ],
  "author": {
    "name": "Rudransha Gupta",
    "email": "rudranshagupta@gmail.com",
    "url": "https://github.com/0x-rudra"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "axios": "^1.6.0",
    "electron-store": "^8.1.0",
    "ffmpeg-static": "^5.2.0",
    "form-data": "^4.0.0",
    "uiohook-napi": "^1.5.4"
  },
  "build": {
    "appId": "com.rudranshagupta.ezspeak",
    "productName": "EzSpeak",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "wtype*"
        ]
      },
      {
        "from": "whisper-bin",
        "to": "whisper-bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "Rudransha Gupta <rudranshagupta@gmail.com>",
      "synopsis": "Cross-platform voice dictation and transcription desktop app",
      "description": "Cross-platform voice dictation and transcription desktop app powered by Whisper",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "ezspeak",
          "Keywords": "voice;transcription;whisper;dictation;speech-to-text;"
        }
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "EzSpeak requires microphone access to record and transcribe your voice."
      }
    },
    "dmg": {
      "background": "assets/dmg-background.png",
      "iconSize": 120,
      "contents": [
        {
          "x": 180,
          "y": 240
        },
        {
          "x": 480,
          "y": 240,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 660,
        "height": 400
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EzSpeak"
    }
  }
}